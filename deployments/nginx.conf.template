# zhuzhao-ui nginx 配置（P4-9 部署件）
#
# 形态（nginx:alpine envsubst 模板——启动时 ${UPSTREAM_APP} 注入）：
#   - compose 演示栈：UPSTREAM_APP=app（主仓 compose 网络；网关/业务 API 同源 app:33333）
#   - 宿主验证：UPSTREAM_APP=host.docker.internal（app 进程跑宿主 @33333）
#
# 路由拓扑（01 §8-P4-9）：
#   /api/     → app（业务 API——网关+biz 组）
#   /al/api/  → app（网关反代 activelist——**精确前缀**：与前端 hash 路由 /#/al/* 同居
#               /al 前缀但互不冲突：API 是真实 HTTP path，页面路由在 # 后不发服务端）
#   其余      → index.html fallback（当前 hash 路由其实恒落 /，fallback 为未来
#               history 模式与直链容错保留——勿删，二十三批「dev proxy 非生产形态」教训）

server {
    listen 80;
    server_name _;

    # 静态产物根（Dockerfile 已拷入 /usr/share/nginx/html）
    root /usr/share/nginx/html;
    index index.html;

    # gzip（文本资产——JS/CSS 主体积来源）
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 业务 API → app（保留原始 URI 与 X-Forwarded-* 链——app 侧 trusted_proxies
    # 须含本容器网段，否则 ClientIP 恒为 nginx IP、限流桶全站共享）
    location /api/ {
        proxy_pass http://${UPSTREAM_APP}:33333;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 网关 al 反代（同上游——/al/api 前缀整体透传，网关 strip 后转 activelist）
    location /al/api/ {
        proxy_pass http://${UPSTREAM_APP}:33333;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 带内容哈希的静态资产——长缓存（产物文件名含 hash，内容变更即换名）
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback：index.html 不缓存（发布即生效，防白屏旧壳引用已失效资产）
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
