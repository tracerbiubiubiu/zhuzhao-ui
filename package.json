{
  "name": "zhuzhao-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "zhuzhao 控制台前端（IAM + 工单）——单仓单 SPA，底座 vue-element-plus-admin v3 种子",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite --mode base",
    "build": "vite build --mode pro",
    "build:pro": "vite build --mode pro",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "preview": "vite preview --mode pro",
    "ts:check": "vue-tsc --noEmit --skipLibCheck",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "codegen": "bash scripts/codegen.sh",
    "clean": "rimraf dist dist-pro dist-dev dist-test node_modules/.cache"
  },
  "dependencies": {
    "@iconify-icons/mdi": "^1.2.48",
    "@iconify/vue": "^5.0.3",
    "@tanstack/vue-query": "^5.104.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "2.14.4",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/transformer-variant-group": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "less": "^4.8.1",
    "openapi-typescript": "^7.13.0",
    "rimraf": "*",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.7.0",
    "unocss": "^66.7.5",
    "unplugin-element-plus": "0.10.0",
    "vite": "8.2.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.9"
  }
}
