{
  "name": "zhuzhao-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "zhuzhao 控制台前端（IAM + 工单）——单仓单 SPA，底座 vue-element-plus-admin v3 种子",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite --mode base",
    "build": "vite build --mode pro",
    "build:pro": "vite build --mode pro",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "preview": "vite preview --mode pro",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "gate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run audit:prod && pnpm run build && pnpm run test:e2e",
    "codegen": "bash scripts/codegen.sh",
    "clean": "rimraf dist dist-pro dist-dev dist-test node_modules/.cache",
    "hooks": "sh scripts/install-git-hooks.sh",
    "commit-lint": "python3 scripts/commit-policy.py pending",
    "test:commit-lint": "python3 scripts/test-commit-policy.py"
  },
  "dependencies": {
    "@iconify-icons/mdi": "2.0.0",
    "@iconify/vue": "^5.0.5",
    "@logicflow/core": "2.2.5",
    "@tanstack/vue-query": "^5.107.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "cropperjs": "1.7.0",
    "echarts": "^6.1.0",
    "element-plus": "2.14.8",
    "md-editor-v3": "7.1.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sortablejs": "^1.15.7",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@unocss/transformer-variant-group": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "less": "^4.9.1",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.4",
    "swagger2openapi": "^7.0.8",
    "typescript": "5.9.3",
    "unocss": "^66.12.0",
    "unplugin-element-plus": "0.10.0",
    "vite": "8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
